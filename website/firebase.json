{
  "hosting": [
    {
      "target": "main",
      "public": ".",
      "redirects": [
        {
          "source": "/unsubscirbe",
          "destination": "/unsubscribe/",
          "type": 301
        },
        {
          "source": "/unsubscirbe/**",
          "destination": "/unsubscribe/",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=86400"
            }
          ]
        },
        {
          "source": "**/*.@(html|xml|txt)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/roadmap/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            }
          ]
        },
        {
          "source": "/unsubscribe/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            }
          ]
        },
        {
          "source": "/health/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            }
          ]
        },
        {
          "source": "/health.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            }
          ]
        }
      ],
      "ignore": [
        "firebase.json",
        "blog-redirect/**",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "blog",
      "public": "blog-redirect",
      "redirects": [
        {
          "source": "**",
          "destination": "https://getocean.dev/blogs/",
          "type": 301
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ]
}
